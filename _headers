# Netlify-specific. If the site ever moves hosts, this has to be redone in
# whatever the new one uses.

/*
  # The site is static and same-origin apart from the analytics tag, so the
  # policy can stay tight. script-src has to name cloud.umami.is, and
  # connect-src the endpoint its script posts events to. The JSON-LD block in
  # index.html needs no allowance: CSP only governs <script> elements whose
  # type is a JavaScript MIME type, and application/ld+json is a data block.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cloud.umami.is; connect-src 'self' https://cloud.umami.is https://api-gateway.umami.dev; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()

# Netlify serves .webmanifest as application/octet-stream because it doesn't know
# the extension. The spec requires application/manifest+json, and Chrome warns
# about the mismatch when installing the site.
/site.webmanifest
  Content-Type: application/manifest+json

# Assets are referenced by fixed paths with no fingerprinting, so they cannot be
# cached immutably — a deploy has to be able to replace them. An hour is long
# enough to help a repeat visit and short enough that a fix is not stranded.
/css/*
  Cache-Control: public, max-age=3600
/js/*
  Cache-Control: public, max-age=3600
/img/*
  Cache-Control: public, max-age=86400
